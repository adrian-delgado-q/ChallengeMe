{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "ts-node index.ts",
    "seed": "ts-node database/seeder/fakeData.ts",
    "migrate:sql": "cd sql && node apply_migrations.js",
    "validate:db": "node -e \"require('pg').Client({connectionString:process.env.SUPABASE_DB_URL}).connect().then(c=>c.query(require('fs').readFileSync('sql/validate_database.sql','utf8')).then(r=>console.log(r.rows)).finally(()=>c.end()))\""
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^16.0.0",
    "pg": "^8.16.0",
    "prisma": "^6.10.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}