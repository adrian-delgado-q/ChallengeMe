generator pothos {
  provider = "prisma-pothos-types"
}

generator client {
  provider = "prisma-client-js"
  output   = "./prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_DB_URL_STRING")
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum ChallengeParticipantType {
  INDIVIDUAL
  TEAM
}

enum ChallengeStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum ModeratorRole {
  MODERATOR
  ADMIN
}

model SchemaMigration {
  version String @id @db.VarChar

  @@map("schema_migrations")
}

model Profile {
  id                 String                 @id @db.Uuid
  username           String?                @unique
  avatar_url         String?
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  updated_at         DateTime               @updatedAt @db.Timestamptz(6)
  activities         Activity[]
  challenge_entries  ChallengeParticipant[]
  created_challenges Challenge[]            @relation("challenge_creator")
  comments           Comment[]
  banned_users       DiscussionBan[]        @relation("banned_users")
  discussion_bans    DiscussionBan[]
  granted_moderators DiscussionModerator[]  @relation("granted_moderators")
  moderator_roles    DiscussionModerator[]
  discussion_posts   DiscussionPost[]
  discussion_replies DiscussionReply[]
  posts              Post[]
  team_memberships   TeamMembership[]
  created_teams      Team[]                 @relation("team_creator")
  created_workouts   Workout[]              @relation("workout_creator")
  workout_sessions   WorkoutSession[]
  workout_comment    WorkoutComment[]

  @@map("profiles")
}

model Team {
  id                String                 @id @default(uuid()) @db.Uuid
  creator_id        String                 @db.Uuid
  name              String
  description       String?
  avatar_url        String?
  is_public         Boolean                @default(true)
  access_code       String?
  created_at        DateTime               @default(now()) @db.Timestamptz(6)
  expires_at        DateTime?              @db.Timestamptz(6)
  max_members       Int?
  member_count      Int                    @default(0)
  sports_types      String[]
  challenge_entries ChallengeParticipant[]
  team_memberships  TeamMembership[]
  creator           Profile                @relation("team_creator", fields: [creator_id], references: [id])
  workouts          Workout[]              @relation("TeamWorkouts")

  @@map("teams")
}

model TeamMembership {
  id         String    @id @default(uuid()) @db.Uuid
  team_id    String    @db.Uuid
  user_id    String    @db.Uuid
  role       TeamRole  @default(MEMBER)
  joined_at  DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime? @db.Timestamptz(6)
  team       Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user       Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@map("team_memberships")
}

model Challenge {
  id                    String                   @id @default(uuid()) @db.Uuid
  creator_id            String                   @db.Uuid
  title                 String
  description           String?
  instructions          String?
  image_url             String?
  challenge_type        ChallengeParticipantType @default(INDIVIDUAL)
  max_participants      Int?
  participant_count     Int                      @default(0)
  start_date            DateTime                 @db.Date
  end_date              DateTime                 @db.Date
  is_public             Boolean                  @default(true)
  access_code           String?
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  expires_at            DateTime?                @db.Timestamptz(6)
  max_team_size         Int?
  status                ChallengeStatus          @default(ACTIVE)
  activities            Activity[]
  supported_activities  ChallengeActivityType[]
  participants          ChallengeParticipant[]
  creator               Profile                  @relation("challenge_creator", fields: [creator_id], references: [id])
  discussion_bans       DiscussionBan[]
  discussion_moderators DiscussionModerator[]
  discussion_posts      DiscussionPost[]
  milestones            Milestone[]
  posts                 Post[]

  @@index([creator_id, status], map: "idx_challenge_creator_status")
  @@index([status], map: "idx_challenge_status")
  @@map("challenges")
}

model ChallengeActivityType {
  id               String       @id @default(uuid()) @db.Uuid
  challenge_id     String       @db.Uuid
  activity_type_id String       @db.Uuid
  activity_type    ActivityType @relation(fields: [activity_type_id], references: [id])
  challenge        Challenge    @relation(fields: [challenge_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, activity_type_id])
  @@map("challenge_activity_types")
}

model Milestone {
  id                   String              @id @default(uuid()) @db.Uuid
  challenge_id         String              @db.Uuid
  activity_type_id     String              @db.Uuid
  name                 String
  description          String?
  target_value         Float
  order                Int
  created_at           DateTime            @default(now()) @db.Timestamptz(6)
  participant_progress MilestoneProgress[]
  activity_type        ActivityType        @relation(fields: [activity_type_id], references: [id])
  challenge            Challenge           @relation(fields: [challenge_id], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model MilestoneProgress {
  id             String               @id @default(uuid()) @db.Uuid
  milestone_id   String               @db.Uuid
  participant_id String               @db.Uuid
  current_value  Int                  @default(0)
  is_achieved    Boolean              @default(false)
  achieved_at    DateTime?            @db.Timestamptz(6)
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @updatedAt @db.Timestamptz(6)
  milestone      Milestone            @relation(fields: [milestone_id], references: [id], onDelete: Cascade)
  participant    ChallengeParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  @@unique([milestone_id, participant_id])
  @@map("milestone_progress")
}

model ChallengeParticipant {
  id                 String              @id @default(uuid()) @db.Uuid
  challenge_id       String              @db.Uuid
  user_id            String?             @db.Uuid
  team_id            String?             @db.Uuid
  joined_at          DateTime            @default(now()) @db.Timestamptz(6)
  activities         Activity[]
  challenge          Challenge           @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  team               Team?               @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user               Profile?            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  milestone_progress MilestoneProgress[]
  posts              Post[]

  @@index([challenge_id, user_id], map: "idx_challengeparticipant_challengeid_userid_unique")
  @@index([challenge_id, team_id], map: "idx_challengeparticipant_challengeid_teamid_unique")
  @@map("challenge_participants")
}

model ActivityType {
  id                String                  @id @default(uuid()) @db.Uuid
  name              String                  @unique
  category          String
  unit              String
  unit_label        String
  description       String?
  is_active         Boolean                 @default(true)
  created_at        DateTime                @default(now()) @db.Timestamptz(6)
  activities        Activity[]
  challenges        ChallengeActivityType[]
  milestones        Milestone[]
  workout_exercises WorkoutExercise[]

  @@map("activity_types")
}

model Activity {
  id                 String                @id @default(uuid()) @db.Uuid
  participant_id     String?               @db.Uuid
  activity_type_id   String                @db.Uuid
  value              Float
  notes              String?
  date               DateTime              @db.Date
  uploaded_at        DateTime              @default(now()) @db.Timestamptz(6)
  profile_id         String?               @db.Uuid
  challenge_id       String?               @db.Uuid
  workout_session_id String?               @db.Uuid
  activity_type      ActivityType          @relation(fields: [activity_type_id], references: [id])
  Challenge          Challenge?            @relation(fields: [challenge_id], references: [id])
  participant        ChallengeParticipant? @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  Profile            Profile?              @relation(fields: [profile_id], references: [id])
  workout_session    WorkoutSession?       @relation(fields: [workout_session_id], references: [id])

  @@map("activities")
}

model Post {
  id             String               @id @default(uuid()) @db.Uuid
  participant_id String               @db.Uuid
  content        String?
  image_url      String?
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  profile_id     String?              @db.Uuid
  challenge_id   String?              @db.Uuid
  comments       Comment[]
  Challenge      Challenge?           @relation(fields: [challenge_id], references: [id])
  participant    ChallengeParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  Profile        Profile?             @relation(fields: [profile_id], references: [id])

  @@map("posts")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  author_id  String   @db.Uuid
  post_id    String   @db.Uuid
  content    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  author     Profile  @relation(fields: [author_id], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("comments")
}

model DiscussionPost {
  id            String            @id @default(uuid()) @db.Uuid
  challenge_id  String            @db.Uuid
  author_id     String            @db.Uuid
  content       String
  is_pinned     Boolean           @default(false)
  is_deleted    Boolean           @default(false)
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  updated_at    DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  reply_count   Int               @default(0)
  last_reply_at DateTime?         @db.Timestamptz(6)
  author        Profile           @relation(fields: [author_id], references: [id], onDelete: Cascade)
  challenge     Challenge         @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  replies       DiscussionReply[]

  @@index([challenge_id, created_at])
  @@index([challenge_id, is_pinned, created_at])
  @@index([challenge_id, author_id], map: "idx_discussion_posts_challenge_author")
  @@map("discussion_posts")
}

model DiscussionReply {
  id         String            @id @default(uuid()) @db.Uuid
  post_id    String            @db.Uuid
  parent_id  String?           @db.Uuid
  author_id  String            @db.Uuid
  content    String
  is_deleted Boolean           @default(false)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  updated_at DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  author     Profile           @relation(fields: [author_id], references: [id], onDelete: Cascade)
  parent     DiscussionReply?  @relation("ReplyThread", fields: [parent_id], references: [id], onDelete: Cascade)
  replies    DiscussionReply[] @relation("ReplyThread")
  post       DiscussionPost    @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id, created_at])
  @@index([parent_id, created_at])
  @@index([post_id, author_id], map: "idx_discussion_replies_post_author")
  @@map("discussion_replies")
}

model DiscussionModerator {
  id            String        @id @default(uuid()) @db.Uuid
  challenge_id  String        @db.Uuid
  user_id       String        @db.Uuid
  role          ModeratorRole @default(MODERATOR)
  granted_at    DateTime      @default(now()) @db.Timestamptz(6)
  granted_by_id String        @db.Uuid
  challenge     Challenge     @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  granted_by    Profile       @relation("granted_moderators", fields: [granted_by_id], references: [id])
  user          Profile       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, user_id])
  @@index([challenge_id, user_id], map: "idx_discussion_moderators_challenge_user")
  @@map("discussion_moderators")
}

model DiscussionBan {
  id           String    @id @default(uuid()) @db.Uuid
  challenge_id String    @db.Uuid
  user_id      String    @db.Uuid
  reason       String?
  banned_at    DateTime  @default(now()) @db.Timestamptz(6)
  expires_at   DateTime? @db.Timestamptz(6)
  banned_by_id String    @db.Uuid
  is_active    Boolean   @default(true)
  banned_by    Profile   @relation("banned_users", fields: [banned_by_id], references: [id])
  challenge    Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  user         Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, user_id, is_active])
  @@index([challenge_id, is_active])
  @@index([challenge_id, user_id, is_active], map: "idx_discussion_bans_challenge_user_active")
  @@map("discussion_bans")
}

model Workout {
  id              String   @id @default(uuid()) @db.Uuid
  creator_id      String   @db.Uuid
  team_id         String?  @db.Uuid
  name            String
  description     String?
  is_team_workout Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  // AI Generation Fields
  generated_by_ai Boolean @default(false)
  ai_model        String?
  ai_raw_response Json?

  creator   Profile           @relation("workout_creator", fields: [creator_id], references: [id])
  team      Team?             @relation("TeamWorkouts", fields: [team_id], references: [id])
  exercises WorkoutExercise[]
  sessions  WorkoutSession[]
  comments  WorkoutComment[]

  @@map("workouts")
}

model WorkoutExercise {
  id               String  @id @default(uuid()) @db.Uuid
  workout_id       String  @db.Uuid
  activity_type_id String  @db.Uuid
  order_index      Int
  sets             Int?
  reps             Int?
  rest_time        Int? // In seconds
  notes            String?

  workout       Workout      @relation(fields: [workout_id], references: [id], onDelete: Cascade)
  activity_type ActivityType @relation(fields: [activity_type_id], references: [id])

  @@unique([workout_id, order_index])
  @@map("workout_exercises")
}

model WorkoutSession {
  id           String   @id @default(uuid()) @db.Uuid
  workout_id   String   @db.Uuid
  profile_id   String   @db.Uuid
  session_date DateTime @default(now()) @db.Date
  notes        String?
  created_at   DateTime @default(now()) @db.Timestamp(6)

  workout           Workout    @relation(fields: [workout_id], references: [id], onDelete: Cascade)
  profile           Profile    @relation(fields: [profile_id], references: [id])
  logged_activities Activity[] // This links a session to the actual performed activities

  @@map("workout_sessions")
}

model WorkoutComment {
  id         String   @id @default(uuid()) @db.Uuid
  author_id  String   @db.Uuid
  workout_id String   @db.Uuid
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  author  Profile @relation(fields: [author_id], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workout_id], references: [id], onDelete: Cascade)

  @@map("workout_comments")
}
