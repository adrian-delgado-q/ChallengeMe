generator client {
  provider = "prisma-client-ts"
  output   = "./prisma-generated-client"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_DB_URL")
}

model Profile {
  id                String                 @id @db.Uuid
  username          String?                @unique
  avatarUrl         String?                @map("avatar_url")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities        Activity[]
  createdChallenges Challenge[]            @relation("ChallengeCreator")
  challengeEntries  ChallengeParticipant[]
  comments          Comment[]
  posts             Post[]
  createdTeams      Team[]                 @relation("TeamCreator")
  teamMemberships   TeamMembership[]

  @@map("profiles")
}

model Team {
  id               String                 @id @default(uuid()) @db.Uuid
  creatorId        String                 @db.Uuid
  name             String
  description      String?
  avatarUrl        String?
  isPublic         Boolean                @default(true)
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime?              @db.Timestamptz(6)
  maxMembers       Int?
  memberCount      Int                    @default(0) // Add this field that triggers maintain
  sportsTypes      String[]
  challengeEntries ChallengeParticipant[]
  creator          Profile                @relation("TeamCreator", fields: [creatorId], references: [id])
  teamMemberships  TeamMembership[]
}

model TeamMembership {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @db.Uuid
  userId    String    @db.Uuid
  role      TeamRole  @default(MEMBER)
  joinedAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime? @db.Timestamptz(6)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Challenge {
  id                  String                   @id @default(uuid()) @db.Uuid
  creatorId           String                   @db.Uuid
  title               String
  description         String?
  challengeType       ChallengeParticipantType @default(INDIVIDUAL)
  maxParticipants     Int?
  participantCount    Int                      @default(0) // Add this field that triggers maintain
  startDate           DateTime                 @db.Date
  endDate             DateTime                 @db.Date
  isPublic            Boolean                  @default(true)
  accessCode          String? // Optional access code for private challenges
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  expiresAt           DateTime?                @db.Timestamptz(6)
  maxTeamSize         Int?
  status              ChallengeStatus          @default(ACTIVE)
  activities          Activity[]
  creator             Profile                  @relation("ChallengeCreator", fields: [creatorId], references: [id])
  participants        ChallengeParticipant[]
  milestones          Milestone[]
  posts               Post[]
  supportedActivities ChallengeActivityType[] // Many-to-many relation for supported activity types
  progress            ChallengeProgress[] // Progress aggregation for this challenge

  @@index([creatorId, status], map: "idx_challenge_creator_status")
  @@index([status], map: "idx_challenge_status")
}

model ChallengeActivityType {
  id             String       @id @default(uuid()) @db.Uuid
  challengeId    String       @db.Uuid
  activityTypeId String       @db.Uuid
  challenge      Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id])

  @@unique([challengeId, activityTypeId])
}

model Milestone {
  id                  String              @id @default(uuid()) @db.Uuid
  challengeId         String              @db.Uuid
  activityTypeId      String              @db.Uuid // Which activity type this milestone is for
  name                String
  description         String?
  targetValue         Float // Target value in the activity's unit
  order               Int
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  activityType        ActivityType        @relation(fields: [activityTypeId], references: [id])
  challenge           Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participantProgress MilestoneProgress[]
}

model MilestoneProgress {
  id            String               @id @default(uuid()) @db.Uuid
  milestoneId   String               @db.Uuid
  participantId String               @db.Uuid
  currentValue  Int                  @default(0)
  isAchieved    Boolean              @default(false)
  achievedAt    DateTime?            @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)
  milestone     Milestone            @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  participant   ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, participantId])
}

model ChallengeParticipant {
  id                String              @id @default(uuid()) @db.Uuid
  challengeId       String              @db.Uuid
  userId            String?             @db.Uuid
  teamId            String?             @db.Uuid
  joinedAt          DateTime            @default(now()) @db.Timestamptz(6)
  activities        Activity[]
  challenge         Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team              Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              Profile?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneProgress MilestoneProgress[]
  posts             Post[]
  progress          ChallengeProgress[] // Progress aggregation for this participant

  // Partial unique constraints for preventing duplicate participations
  // Note: These are implemented as partial unique indexes in SQL since Prisma doesn't support conditional unique constraints
  @@index([challengeId, userId], map: "idx_challengeparticipant_challengeid_userid_unique")
  @@index([challengeId, teamId], map: "idx_challengeparticipant_challengeid_teamid_unique")
}

model ActivityType {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @unique // e.g., "Running", "Cycling", "Push-ups", "Meditation"
  category    String // e.g., "Cardio", "Strength", "Flexibility", "Mindfulness"
  unit        String // e.g., "km", "minutes", "reps", "sets"
  unitLabel   String // e.g., "kilometers", "minutes", "repetitions", "sets"
  description String?
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now()) @db.Timestamptz(6)
  activities  Activity[]
  milestones  Milestone[]
  challenges  ChallengeActivityType[]
  progress    ChallengeProgress[] // Progress aggregation for this activity type
}

model Activity {
  id             String               @id @default(uuid()) @db.Uuid
  participantId  String               @db.Uuid
  activityTypeId String               @db.Uuid
  value          Float // The numeric value (distance, time, reps, etc.)
  notes          String?
  date           DateTime             @db.Date
  uploadedAt     DateTime             @default(now()) @db.Timestamptz(6)
  profileId      String?              @db.Uuid
  challengeId    String?              @db.Uuid
  activityType   ActivityType         @relation(fields: [activityTypeId], references: [id])
  Challenge      Challenge?           @relation(fields: [challengeId], references: [id])
  participant    ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  Profile        Profile?             @relation(fields: [profileId], references: [id])
}

model ChallengeProgress {
  id               String    @id @default(uuid()) @db.Uuid
  challengeId      String    @db.Uuid
  participantId    String    @db.Uuid
  activityTypeId   String    @db.Uuid
  totalValue       Float     @default(0) // Aggregated total value
  activityCount    Int       @default(0) // Number of activities recorded
  averageValue     Float     @default(0) // Average value per activity
  bestValue        Float     @default(0) // Best single activity value
  lastActivityDate DateTime? @db.Date // Date of most recent activity
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  // Relations
  challenge    Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participant  ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  activityType ActivityType         @relation(fields: [activityTypeId], references: [id])

  // Unique constraint to ensure one record per challenge/participant/activityType combination
  @@unique([challengeId, participantId, activityTypeId])
  // Indexes for fast lookups
  @@index([challengeId, activityTypeId], map: "idx_challenge_progress_challenge_activity")
  @@index([participantId, challengeId], map: "idx_challenge_progress_participant_challenge")
  @@index([challengeId, totalValue], map: "idx_challenge_progress_leaderboard")
  @@map("challenge_progress")
}

model Post {
  id            String               @id @default(uuid()) @db.Uuid
  participantId String               @db.Uuid
  content       String?
  imageUrl      String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  profileId     String?              @db.Uuid
  challengeId   String?              @db.Uuid
  comments      Comment[]
  Challenge     Challenge?           @relation(fields: [challengeId], references: [id])
  participant   ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  Profile       Profile?             @relation(fields: [profileId], references: [id])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  postId    String   @db.Uuid
  content   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum ChallengeParticipantType {
  INDIVIDUAL
  TEAM
}

enum ChallengeStatus {
  ACTIVE
  CLOSED
  CANCELLED
}
