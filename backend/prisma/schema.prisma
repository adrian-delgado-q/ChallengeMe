generator client {
  provider = "prisma-client-ts"
  output   = "./prisma-generated-client"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_DB_URL_STRING")
}

model Profile {
  id                String                 @id @db.Uuid
  username          String?                @unique
  avatarUrl         String?                @map("avatar_url")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities        Activity[]
  challengeEntries  ChallengeParticipant[]
  createdChallenges Challenge[]            @relation("ChallengeCreator")
  comments          Comment[]
  bannedUsers       DiscussionBan[]        @relation("BannedUsers")
  discussionBans    DiscussionBan[]
  grantedModerators DiscussionModerator[]  @relation("GrantedModerators")
  moderatorRoles    DiscussionModerator[]
  discussionPosts   DiscussionPost[]
  discussionReplies DiscussionReply[]
  posts             Post[]
  teamMemberships   TeamMembership[]
  createdTeams      Team[]                 @relation("TeamCreator")
  createdWorkouts   Workout[]              @relation("WorkoutCreator")
  workoutSessions   WorkoutSession[]
  WorkoutComment    WorkoutComment[]

  @@map("profiles")
}

model Team {
  id               String                 @id @default(uuid()) @db.Uuid
  creatorId        String                 @db.Uuid
  name             String
  description      String?
  avatarUrl        String?
  isPublic         Boolean                @default(true)
  accessCode       String?
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime?              @db.Timestamptz(6)
  maxMembers       Int?
  memberCount      Int                    @default(0)
  sportsTypes      String[]
  challengeEntries ChallengeParticipant[]
  teamMemberships  TeamMembership[]
  creator          Profile                @relation("TeamCreator", fields: [creatorId], references: [id])
  workouts         Workout[]              @relation("TeamWorkouts")

  @@map("teams")
}

model TeamMembership {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @db.Uuid
  userId    String    @db.Uuid
  role      TeamRole  @default(MEMBER)
  joinedAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime? @db.Timestamptz(6)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_memberships")
}

model Challenge {
  id                   String                   @id @default(uuid()) @db.Uuid
  creatorId            String                   @db.Uuid
  title                String
  description          String?
  instructions         String?
  imageUrl             String?
  challengeType        ChallengeParticipantType @default(INDIVIDUAL)
  maxParticipants      Int?
  participantCount     Int                      @default(0)
  startDate            DateTime                 @db.Date
  endDate              DateTime                 @db.Date
  isPublic             Boolean                  @default(true)
  accessCode           String?
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  expiresAt            DateTime?                @db.Timestamptz(6)
  maxTeamSize          Int?
  status               ChallengeStatus          @default(ACTIVE)
  activities           Activity[]
  supportedActivities  ChallengeActivityType[]
  participants         ChallengeParticipant[]
  creator              Profile                  @relation("ChallengeCreator", fields: [creatorId], references: [id])
  discussionBans       DiscussionBan[]
  discussionModerators DiscussionModerator[]
  discussionPosts      DiscussionPost[]
  milestones           Milestone[]
  posts                Post[]

  @@index([creatorId, status], map: "idx_challenge_creator_status")
  @@index([status], map: "idx_challenge_status")
  @@map("challenges")
}

model ChallengeActivityType {
  id             String       @id @default(uuid()) @db.Uuid
  challengeId    String       @db.Uuid
  activityTypeId String       @db.Uuid
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id])
  challenge      Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, activityTypeId])
  @@map("challenge_activity_types")
}

model Milestone {
  id                  String              @id @default(uuid()) @db.Uuid
  challengeId         String              @db.Uuid
  activityTypeId      String              @db.Uuid
  name                String
  description         String?
  targetValue         Float
  order               Int
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  participantProgress MilestoneProgress[]
  activityType        ActivityType        @relation(fields: [activityTypeId], references: [id])
  challenge           Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model MilestoneProgress {
  id            String               @id @default(uuid()) @db.Uuid
  milestoneId   String               @db.Uuid
  participantId String               @db.Uuid
  currentValue  Int                  @default(0)
  isAchieved    Boolean              @default(false)
  achievedAt    DateTime?            @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)
  milestone     Milestone            @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  participant   ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, participantId])
  @@map("milestone_progress")
}

model ChallengeParticipant {
  id                String              @id @default(uuid()) @db.Uuid
  challengeId       String              @db.Uuid
  userId            String?             @db.Uuid
  teamId            String?             @db.Uuid
  joinedAt          DateTime            @default(now()) @db.Timestamptz(6)
  activities        Activity[]
  challenge         Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team              Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              Profile?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneProgress MilestoneProgress[]
  posts             Post[]

  @@index([challengeId, userId], map: "idx_challengeparticipant_challengeid_userid_unique")
  @@index([challengeId, teamId], map: "idx_challengeparticipant_challengeid_teamid_unique")
  @@map("challenge_participants")
}

model ActivityType {
  id               String                  @id @default(uuid()) @db.Uuid
  name             String                  @unique
  category         String
  unit             String
  unitLabel        String
  description      String?
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  activities       Activity[]
  challenges       ChallengeActivityType[]
  milestones       Milestone[]
  workoutExercises WorkoutExercise[]

  @@map("activity_types")
}

model Activity {
  id               String               @id @default(uuid()) @db.Uuid
  participantId    String?              @db.Uuid
  activityTypeId   String               @db.Uuid
  value            Float
  notes            String?
  date             DateTime             @db.Date
  uploadedAt       DateTime             @default(now()) @db.Timestamptz(6)
  profileId        String?              @db.Uuid
  challengeId      String?              @db.Uuid
  workoutSessionId String?              @db.Uuid
  activityType     ActivityType         @relation(fields: [activityTypeId], references: [id])
  Challenge        Challenge?           @relation(fields: [challengeId], references: [id])
  participant      ChallengeParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  Profile          Profile?             @relation(fields: [profileId], references: [id])
  workoutSession   WorkoutSession?      @relation(fields: [workoutSessionId], references: [id])

  @@map("activities")
}

model Post {
  id            String               @id @default(uuid()) @db.Uuid
  participantId String               @db.Uuid
  content       String?
  imageUrl      String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  profileId     String?              @db.Uuid
  challengeId   String?              @db.Uuid
  comments      Comment[]
  Challenge     Challenge?           @relation(fields: [challengeId], references: [id])
  participant   ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  Profile       Profile?             @relation(fields: [profileId], references: [id])

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  postId    String   @db.Uuid
  content   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model DiscussionPost {
  id          String            @id @default(uuid()) @db.Uuid
  challengeId String            @db.Uuid
  authorId    String            @db.Uuid
  content     String
  isPinned    Boolean           @default(false)
  isDeleted   Boolean           @default(false)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  replyCount  Int               @default(0)
  lastReplyAt DateTime?         @db.Timestamptz(6)
  author      Profile           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  replies     DiscussionReply[]

  @@index([challengeId, createdAt])
  @@index([challengeId, isPinned, createdAt])
  @@index([challengeId, authorId], map: "idx_discussion_posts_challenge_author")
  @@map("discussion_posts")
}

model DiscussionReply {
  id        String            @id @default(uuid()) @db.Uuid
  postId    String            @db.Uuid
  parentId  String?           @db.Uuid
  authorId  String            @db.Uuid
  content   String
  isDeleted Boolean           @default(false)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  author    Profile           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    DiscussionReply?  @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DiscussionReply[] @relation("ReplyThread")
  post      DiscussionPost    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([postId, authorId], map: "idx_discussion_replies_post_author")
  @@map("discussion_replies")
}

model DiscussionModerator {
  id          String        @id @default(uuid()) @db.Uuid
  challengeId String        @db.Uuid
  userId      String        @db.Uuid
  role        ModeratorRole @default(MODERATOR)
  grantedAt   DateTime      @default(now()) @db.Timestamptz(6)
  grantedById String        @db.Uuid
  challenge   Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  grantedBy   Profile       @relation("GrantedModerators", fields: [grantedById], references: [id])
  user        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, userId], map: "idx_discussion_moderators_challenge_user")
  @@map("discussion_moderators")
}

model DiscussionBan {
  id          String    @id @default(uuid()) @db.Uuid
  challengeId String    @db.Uuid
  userId      String    @db.Uuid
  reason      String?
  bannedAt    DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)
  bannedById  String    @db.Uuid
  isActive    Boolean   @default(true)
  bannedBy    Profile   @relation("BannedUsers", fields: [bannedById], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, isActive])
  @@index([challengeId, isActive])
  @@index([challengeId, userId, isActive], map: "idx_discussion_bans_challenge_user_active")
  @@map("discussion_bans")
}

model schema_migrations {
  version String @id @db.VarChar
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum ChallengeParticipantType {
  INDIVIDUAL
  TEAM
}

enum ChallengeStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum ModeratorRole {
  MODERATOR
  ADMIN
}

model Workout {
  id            String   @id @default(uuid()) @db.Uuid
  creatorId     String   @db.Uuid
  teamId        String?  @db.Uuid
  name          String
  description   String?
  isTeamWorkout Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  // AI Generation Fields
  generatedByAI Boolean @default(false)
  aiModel       String?
  aiRawResponse Json?

  creator   Profile           @relation("WorkoutCreator", fields: [creatorId], references: [id])
  team      Team?             @relation("TeamWorkouts", fields: [teamId], references: [id])
  exercises WorkoutExercise[]
  sessions  WorkoutSession[]
  comments  WorkoutComment[]

  @@map("workouts")
}

model WorkoutExercise {
  id             String  @id @default(uuid()) @db.Uuid
  workoutId      String  @db.Uuid
  activityTypeId String  @db.Uuid
  orderIndex     Int
  sets           Int?
  reps           Int?
  restTime       Int? // In seconds
  notes          String?

  workout      Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  activityType ActivityType @relation(fields: [activityTypeId], references: [id])

  @@unique([workoutId, orderIndex])
  @@map("workout_exercises")
}

model WorkoutSession {
  id          String   @id @default(uuid()) @db.Uuid
  workoutId   String   @db.Uuid
  profileId   String   @db.Uuid
  sessionDate DateTime @default(now()) @db.Date
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  workout          Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  profile          Profile    @relation(fields: [profileId], references: [id])
  loggedActivities Activity[] // This links a session to the actual performed activities

  @@map("workout_sessions")
}

model WorkoutComment {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  workoutId String   @db.Uuid
  content   String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  author  Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@map("workout_comments")
}
